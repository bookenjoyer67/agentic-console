/target

# a user's own environment, if they copy the example
.env

# runtime state. The curated corpus under .memory/reference/ IS committed; the storage database is
# run output and never is.
.memory/storage.db
.memory/storage.db-wal
.memory/storage.db-shm

# Python bytecode: the pipeline's modules are run from source, never from a cached compile.
__pycache__/
*.pyc

# The interpreter the scorecard driver runs under, built from requirements-scorecard.txt. It is a
# local install, never committed: the pin in that file is what makes it reproducible.
.venv/
