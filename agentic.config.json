{
  "schema_version": 1,
  "_purpose": [
    "The single seam table for this agentic quality gate. Every value here is a place where a fork",
    "must depart from Komun. The consumers are: mcp/gate/server.py, scripts/run-agent.sh,",
    "scripts/classify-change.py, scripts/validate_doc_conformance_deterministic.py and",
    "eval/test_policy.py. Each consumer reads this file and exposes what it consumed through",
    "`--print-config`, so scripts/port-self-test.sh can prove the wiring instead of trusting it.",
    "Absent or unreadable, every consumer falls back to the values below, which are this repository's.",
    "See PORTING.md for the fork checklist."
  ],
  "project": {
    "name": "agentic-console",
    "language": "rust",
    "repo_marker": "Cargo.toml"
  },
  "toolchain": {
    "commands": {
      "test": {
        "argv": [
          "cargo",
          "test",
          "--release"
        ],
        "description": "unit-test gate: the workspace test suites",
        "guard": null,
        "summary": null,
        "writes": false
      },
      "clippy": {
        "argv": [
          "cargo",
          "clippy",
          "--release",
          "--all-targets",
          "--",
          "-D",
          "warnings"
        ],
        "description": "lint gate: release clippy over all targets, warnings are errors",
        "guard": {
          "marker": "Checking agentic-console",
          "marker_regex": "\\bChecking\\b\\s+(?P<marker>agentic-console)\\b",
          "touch_file": "src/main.rs",
          "reason": "a cached clippy run prints nothing and exits 0, which is indistinguishable from a clean lint; the touched file forces a real check"
        },
        "summary": null,
        "writes": false
      },
      "fmt": {
        "argv": [
          "cargo",
          "fmt",
          "--check"
        ],
        "description": "formatting gate: check mode, no files are written",
        "guard": null,
        "summary": {
          "reason": "the fmt payload runs to six figures of characters and the counts exist only inside it, so a role reading the response cannot reach them; counting before the clamp puts the four numbers in the response and in the journal row",
          "streams": [
            "stdout",
            "stderr"
          ],
          "strip_ansi": true,
          "counts": {
            "hunks": {
              "mode": "count_matching_lines",
              "pattern": "^Diff in "
            },
            "files": {
              "mode": "count_unique_groups",
              "pattern": "^Diff in (?P<value>.+?)(?:(?::|\\s+at\\s+line\\s+)\\d+)?:?\\s*$",
              "group": "value"
            },
            "added": {
              "mode": "count_matching_lines",
              "pattern": "^\\+"
            },
            "removed": {
              "mode": "count_matching_lines",
              "pattern": "^-"
            }
          }
        },
        "writes": false
      },
      "policy": {
        "argv": [
          "python3",
          "-m",
          "pytest",
          "eval/test_policy.py",
          "eval/test_deterministic_step.py",
          "-q"
        ],
        "description": "policy gate: the governance and deterministic-step eval suites",
        "guard": null,
        "summary": null,
        "writes": false
      },
      "conformance": {
        "argv": [
          "python3",
          "scripts/run-conformance-gate.py"
        ],
        "description": "conformance gate: the prose and citation check, run against base and failing on new drift only",
        "guard": null,
        "summary": null,
        "writes": false
      },
      "fmt-fix": {
        "argv": [
          "cargo",
          "fmt",
          "--all"
        ],
        "description": "formatting fix: write mode, rewrites files",
        "guard": null,
        "summary": null,
        "writes": true
      },
      "webcheck": {
        "argv": [
          "npm",
          "--prefix",
          "web",
          "run",
          "check"
        ],
        "description": "frontend type-check gate: svelte-kit sync and svelte-check over web/",
        "guard": null,
        "summary": null,
        "writes": false
      },
      "webtest": {
        "argv": [
          "npm",
          "--prefix",
          "web",
          "run",
          "test"
        ],
        "description": "frontend unit-test gate: the vitest suites under web/",
        "guard": null,
        "summary": null,
        "writes": false
      }
    },
    "cache_dirs": [
      "target"
    ]
  },
  "containers": {
    "base_image": "agent-sandbox:console",
    "tools_image": "agent-sandbox:console-m1",
    "workspace": "/workspace",
    "memory_subpath": ".memory",
