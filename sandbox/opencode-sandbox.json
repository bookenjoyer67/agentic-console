{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "webfetch": "deny"
  },
  "provider": {
    "sandbox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Sandbox broker (OpenAI-compatible)",
      "options": {
        "baseURL": "http://console-broker:4000/v1",
        "apiKey": "sandbox-dummy-token"
      },
      "models": {
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash (via broker)" }
      }
    }
  }
}
